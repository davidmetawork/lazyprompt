{
  "name": "lazyprompt",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "vercel-build": "pnpm db:migrate && ([ \"$SEED_ON_BUILD\" = true ] && pnpm db:seed || true) && next build",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --project unit --project unit-dom",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:test:prepare": "tsx scripts/db-test-prepare.ts",
    "db:seed": "tsx scripts/seed.ts",
    "seed:check": "tsx scripts/seed.ts --check",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "widget:build": "vite build --config widget/vite.config.ts && tsx scripts/embed-widget.ts",
    "auth:generate": "npx auth@latest generate --config src/auth/server.ts --output src/db/schema/auth-generated.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@tailwindcss/oxide",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.7",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@better-auth/mcp": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "^2.2.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.9",
    "@vercel/speed-insights": "^2.0.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "drizzle-orm": "0.45.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.49.0",
    "mcp-handler": "^2.2.0",
    "nanoid": "^6.0.1",
    "next": "~16.3.8",
    "next-themes": "^0.4.6",
    "pg": "~8.23.1",
    "radix-ui": "^1.6.7",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "resend": "^6.31.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "~1.63.0",
    "@tailwindcss/postcss": "~4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "~16.3.8",
    "jsdom": "^30.1.1",
    "tailwindcss": "~4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "5.0.3"
  }
}
