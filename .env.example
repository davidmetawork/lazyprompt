# LazyPrompt environment. Copy to .env.local (dev) and fill in the two secrets:
#   cp .env.example .env.local && openssl rand -base64 32   (use for BETTER_AUTH_SECRET and IP_HASH_SALT)
# Tests read .env.test.local first (gitignored), so parallel worktrees can override DBs and ports without touching dev.

# --- Database ------------------------------------------------------------------------------------------------
# Local Postgres 17 on localhost:5432 with no password for your OS user (needs pg_trgm + citext; created by migrations).
#   createdb lazyprompt && createdb lazyprompt_test
DATABASE_URL=postgres://localhost:5432/lazyprompt
# Direct (unpooled) connection used by db:migrate / db:seed. Falls back to DATABASE_URL. Neon: set this to the direct URL.
# DATABASE_URL_UNPOOLED=

# Test databases (see README "Parallel worktrees"). pnpm db:test:prepare creates + migrates both.
TEST_DATABASE_URL=postgres://localhost:5432/lazyprompt_test
TEST_DATABASE_URL_E2E=postgres://localhost:5432/lazyprompt_e2e
# Port the Playwright web server listens on (parallel worktrees: pick a unique one).
E2E_PORT=3100

# --- Auth ----------------------------------------------------------------------------------------------------
# 32+ random bytes. Required on Vercel production/preview; dev/test fall back to an insecure built-in value with a warning.
BETTER_AUTH_SECRET=
# Overrides the base URL (otherwise derived from Vercel env, then http://localhost:$PORT|3000). Set to the tunnel URL for ChatGPT dev mode.
# BETTER_AUTH_URL=
# Canonical production origin, e.g. https://lazyprompt.ai
# NEXT_PUBLIC_SITE_URL=
# Comma-separated emails promoted to admin on user create and on sign-in.
ADMIN_EMAILS=
# Social providers are hidden unless BOTH id and secret are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Email ---------------------------------------------------------------------------------------------------
# Without RESEND_API_KEY, magic links are printed to the server console (and appended to MAGIC_LINK_DEV_SINK if set)
# ONLY outside production: a production deployment (VERCEL_ENV=production, or NODE_ENV=production without a dev sink)
# fails sign-in with an error instead of pretending to send email.
# RESEND_API_KEY=
# EMAIL_FROM="LazyPrompt <login@lazyprompt.ai>"
# JSON lines {email,url,ts}. Ignored when VERCEL_ENV=production.
MAGIC_LINK_DEV_SINK=.data/magic-links.jsonl

# --- App -----------------------------------------------------------------------------------------------------
# Random salt for hashing IPs / actors (never store raw IPs). Required on Vercel production/preview.
IP_HASH_SALT=
# Bearer secret for /api/cron/recompute (unset = the route always returns 401).
# CRON_SECRET=
# Moderation only (OpenAI omni-moderation); optional.
# OPENAI_API_KEY=
# Open reports from distinct reporters needed to auto-hide content.
# REPORT_AUTOHIDE_THRESHOLD=3

# --- MCP / ChatGPT App ---------------------------------------------------------------------------------------
# true enables the OAuth write tools and the HTTP gate.
# MCP_OAUTH_ENABLED=false
# auto | http401 | result
# MCP_AUTH_CHALLENGE=auto
# MCP_WIDGET_DOMAIN=

# --- Preview deployments -------------------------------------------------------------------------------------
# SEO_NOINDEX=true
# SEED_ON_BUILD=true
